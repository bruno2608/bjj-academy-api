		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Verifica se o token foi recebido e salva no ambiente",
							"const jsonData = pm.response.json();",
							"",
							"if (jsonData.access_token) {",
							"  pm.environment.set(\"token\", jsonData.access_token);",
							"  console.log(\"🔐 Token salvo no ambiente:\", jsonData.access_token);",
							"} else {",
							"  console.warn(\"❌ Nenhum token encontrado na resposta.\");",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"adminhml@bjjacademy.com.br\",\n  \"senha\": \"Bjj@123\"\n}"
				},
				"url": {
